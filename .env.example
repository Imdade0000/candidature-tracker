# Optionnel : si absent, l'assistant fonctionne en mode "extractif" gratuit
# (il cite directement les passages pertinents au lieu de les reformuler avec un LLM)
OPENAI_API_KEY=

# Modèle utilisé si une clé OpenAI est fournie
OPENAI_MODEL=gpt-4o-mini

# Chemin de persistance de la base vectorielle Chroma
CHROMA_PATH=./chroma_db

# Intervalle (minutes) du rafraîchissement automatique des flux RSS en arrière-plan
FEED_REFRESH_MINUTES=60

# Score minimal à partir duquel une nouvelle offre génère une alerte.
# 45 = match partiel, 70 = très bon match uniquement.
ALERT_THRESHOLD=45

# Clé protégeant les endpoints coûteux (ask, score-job, refresh, alertes).
# Laisser vide en local pour désactiver la protection.
API_KEY=

# Origines autorisées pour le CORS, séparées par des virgules. "*" = tout.
# En déploiement, préférer la liste exacte, ex : https://mon-app.example.com
ALLOWED_ORIGINS=*